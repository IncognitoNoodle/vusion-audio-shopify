{%- style -%}
  @font-face {
    font-family: 'Codystar';
    src: url('{{ "Codystar-Regular.ttf" | file_url }}') format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  .vusion-neon-container {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .vusion-neon-container {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .vusion-neon-row {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .vusion-neon-neons {
    text-align: center;
    width: 100%;
  }

  .vusion-neon-neons h1 {
    font-size: 5rem;
    text-align: center;
    font-weight: bold;
    font-family: 'Codystar', cursive, sans-serif !important;
    color: {{ section.settings.text_color }};
    -webkit-animation: vusion-glow 2s ease-in-out infinite alternate;
    -moz-animation: vusion-glow 2s ease-in-out infinite alternate;
    animation: vusion-glow 2s ease-in-out infinite alternate;
  }

  @-webkit-keyframes vusion-glow {
    from {
      color: {{ section.settings.text_color }};
      text-shadow: 0 0 10px {{ section.settings.glow_color }}, 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 90px {{ section.settings.glow_color }};
    }
    to {
      color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
      text-shadow: 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 80px {{ section.settings.glow_color }}, 0 1 90px {{ section.settings.glow_color }};
    }
  }

  @-moz-keyframes vusion-glow {
    from {
      color: {{ section.settings.text_color }};
      text-shadow: 0 0 10px {{ section.settings.glow_color }}, 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 90px {{ section.settings.glow_color }};
    }
    to {
      color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
      text-shadow: 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 80px {{ section.settings.glow_color }}, 0 1 90px {{ section.settings.glow_color }};
    }
  }

  @keyframes vusion-glow {
    from {
      color: {{ section.settings.text_color }};
      text-shadow: 0 0 10px {{ section.settings.glow_color }}, 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 90px {{ section.settings.glow_color }};
    }
    to {
      color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
      text-shadow: 0 0 20px {{ section.settings.glow_color }}, 0 0 30px {{ section.settings.glow_color }}, 0 0 40px {{ section.settings.glow_color }}, 0 0 50px {{ section.settings.glow_color }}, 0 0 60px {{ section.settings.glow_color }}, 0 0 70px {{ section.settings.glow_color }}, 0 0 80px {{ section.settings.glow_color }}, 0 1 90px {{ section.settings.glow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .vusion-neon-neons h1 {
      font-size: 3rem;
    }
  }
{%- endstyle -%}

<div class="vusion-neon-container color-{{ section.settings.color_scheme }} gradient">
  <div class="vusion-neon-row">
    <div class="vusion-neon-neons">
      <h1>
        <em>{{ section.settings.text }}</em>
      </h1>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vusion Neon Text",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "text",
      "default": "-feelin' blue-",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#00FFF2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Vusion Neon Text",
      "settings": {
        "text": "-feelin' blue-",
        "text_color": "#FFFFFF",
        "glow_color": "#00FFF2"
      }
    }
  ]
}
{% endschema %}
