    "vusion_v360_testimonials": {
      "type": "vusion-v360-testimonials",
      "blocks": {
        "quote_tiago": {
          "type": "quote",
          "settings": {
            "quote": "\"There is a learning curve and getting used to the sound of the mics in the in-ears, but for the first time in my career I can use in-ears for two hours straight without feeling isolated, and with a great clear sound. For many years I\u2019ve been unable to use two in-ears at the same time, ending up with just one. I need to hear not only the crowd but the room, the energy of the room. I\u2019m very happy to have found this helyes sistem and Mink was very helpful with all the process of getting them done as soon as possible. The in-ears are well built, the sound is strong and defined, the idea is great and it\u2019s working for me. I can control my ambient volume with a simple gesture, and the advantage of being able to have different ambient volumes in each ear is that I can adapt depending on the noise of the stage. If the drums are too close on the right I can always decrease the ambient on that side. Congratulations and keep up the great work!\"",
            "image_alt": "Tiago Bettencourt wearing V360 in-ears on stage",
            "name": "Tiago Bettencourt",
            "role": ""
          }
        },
        "quote_wade": {
          "type": "quote",
          "settings": {
            "quote": "\"For comfortable in-ears to play with, I would choose Vusion Audio for sure! Their perfect fit and superior sound quality make them my top pick for any performance.\"",
            "image_alt": "Wade",
            "name": "Wade",
            "role": "DJ & Producer"
          }
        },
        "quote_johnny": {
          "type": "quote",
          "settings": {
            "quote": "\"With the Z22 In-Ear Monitors, it's like stepping right into the heart of the music. The clarity and depth are unmatched, giving you a full-range sound experience that keeps every detail intact.\"",
            "image_alt": "Johnny Kelvin",
            "name": "Johnny Kelvin",
            "role": "Vocalist DJ"
          }
        }
      },
      "block_order": [
        "quote_tiago",
        "quote_wade",
        "quote_johnny"
      ],
