{% schema %}
{
  "name": "Vusion Model Viewer",
  "tag": "section",
  "class": "vusion-model-viewer-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "3D Model Viewer",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "text",
      "default": "Interact with our product in 3D space",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Vusion Model Viewer"
    }
  ]
}
{% endschema %}

{% style %}
    .vusion-model-viewer-section {
      position: relative;
      height: 100vh;
    }

    .vusion-model-viewer-section model-viewer {
      width: 100%;
      height: 100%;
      background-color: #0A0A0A;
    }

    .vusion-model-viewer-section .vusion-model-viewer-progress-bar {
      display: block;
      width: 33%;
      height: 10%;
      max-height: 2%;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate3d(-50%, -50%, 0);
      border-radius: 25px;
      box-shadow: 0px 3px 10px 3px rgba(0, 0, 0, 0.5), 0px 0px 5px 1px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.9);
      background-color: rgba(0, 0, 0, 0.5);
    }

    .vusion-model-viewer-section .vusion-model-viewer-progress-bar.hide {
      visibility: hidden;
      transition: visibility 0.3s;
    }

    .vusion-model-viewer-section .vusion-model-viewer-update-bar {
      background-color: rgba(255, 255, 255, 0.9);
      width: 0%;
      height: 100%;
      border-radius: 25px;
      float: left;
      transition: width 0.3s;
    }

    .vusion-model-viewer-section #vusion-ar-button {
      background-image: url({{ 'ar_icon.png' | asset_url }});
      background-repeat: no-repeat;
      background-size: 20px 20px;
      background-position: 12px 50%;
      background-color: #fff;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 16px;
      padding: 0px 16px 0px 40px;
      font-size: 14px;
      color:#4285f4;
      height: 36px;
      line-height: 36px;
      border-radius: 18px;
      border: 1px solid #DADCE0;
      font-family: sans-serif;
    }

    #vusion-ar-button:active {
      background-color: #E8EAED;
    }

    #vusion-ar-button:focus {
      outline: none;
    }

    #vusion-ar-button:focus-visible {
      outline: 1px solid #4285f4;
    }

    @keyframes vusion-circle {
      from { transform: translateX(-50%) rotate(0deg) translateX(50px) rotate(0deg); }
      to   { transform: translateX(-50%) rotate(360deg) translateX(50px) rotate(-360deg); }
    }

    @keyframes vusion-elongate {
      from { transform: translateX(100px); }
      to   { transform: translateX(-100px); }
    }

    .vusion-model-viewer-section model-viewer > #vusion-ar-prompt {
      position: absolute;
      left: 50%;
      bottom: 60px;
      animation: vusion-elongate 2s infinite ease-in-out alternate;
      display: none;
    }

    .vusion-model-viewer-section model-viewer[ar-status="session-started"] > #vusion-ar-prompt {
      display: block;
    }

    .vusion-model-viewer-section model-viewer > #vusion-ar-prompt > img {
      animation: vusion-circle 4s linear infinite;
    }

    .vusion-model-viewer-grid {
    display: flex;
    flex-direction: row;
    height: 100vh;
    width: 100%;
    padding-left: 5rem;
    padding-right: 5rem;
  }

  .vusion-model-viewer-column {
    flex: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0A0A0A;
  }

  .vusion-model-viewer-column model-viewer {
    width: 100%;
    height: 100%;
  }

  .vusion-model-viewer-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Responsive: stack columns on smaller screens */
  @media (max-width: 768px) {
    .vusion-model-viewer-grid {
      flex-direction: column;
    }

    .vusion-model-viewer-text, .vusion-model-viewer-column {
      flex: none;
      width: 100%;
      height: 50vh;
    }
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function () {
  const modelViewer = document.querySelector('model-viewer');
  if (!modelViewer) return;

  const progressBar = modelViewer.querySelector('.vusion-model-viewer-progress-bar');
  const updatingBar = modelViewer.querySelector('.vusion-model-viewer-update-bar');

  const onProgress = (event) => {
    updatingBar.style.width = `${event.detail.totalProgress * 100}%`;
    if (event.detail.totalProgress === 1) {
      progressBar.classList.add('hide');
      modelViewer.removeEventListener('progress', onProgress);
    } else {
      progressBar.classList.remove('hide');
    }
  };

  modelViewer.addEventListener('progress', onProgress);
});
{% endjavascript %}

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.1.0/model-viewer.min.js"></script>

<div class="vusion-model-viewer-section color-{{ section.settings.color_scheme }}">
  <div class="vusion-model-viewer-grid">
    <!-- Left Column: Model Viewer -->
    <div class="vusion-model-viewer-column">
      <model-viewer
        src="https://cdn.shopify.com/3d/models/533400b465648e97/6.glb"
        ar
        ar-modes="webxr scene-viewer quick-look"
        camera-controls
        tone-mapping="neutral"
        poster="{{ 'poster.webp' | asset_url }}"
        shadow-intensity="1"
      >
        <div class="vusion-model-viewer-progress-bar hide" slot="progress-bar">
          <div class="vusion-model-viewer-update-bar"></div>
        </div>

        <button slot="ar-button" id="vusion-ar-button">View in your space</button>

        <div id="vusion-ar-prompt">
          <img src="{{ 'ar_hand_prompt.png' | asset_url }}">
        </div>
      </model-viewer>
    </div>

    <!-- Right Column: Header + Subtitle -->
    <div class="vusion-model-viewer-text color-{{ section.settings.color_scheme }}">
      <h2 class="vusion-header {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      <div class="vusion-subtitle">
        {{ section.settings.text }}
      </div>
    </div>
  </div>
</div>
