{% schema %}
{
  "name": "Poster Display",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Image Opacity",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Poster Display",
      "settings": {
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}

{% style %}
  .section-{{ section.id }} {
    background-color: rgb(var(--color-background));
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  {% if section.settings.background_image != blank %}
    .section-{{ section.id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.background_image | img_url: 'master' }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
      z-index: 0;
    }
  {% endif %}

  .vusion-poster-container-{{ section.id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .vusion-poster-{{ section.id }} {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .vusion-poster-{{ section.id }} img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .poster-button-{{ section.id }} {
    position: absolute;
    right: 34%;
    bottom: 4%;
    z-index: 5;
    outline: 0;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: #F32929;
    min-width: 200px;
    border: 0;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
    box-sizing: border-box;
    padding: 16px 20px;
    color: #000000;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .poster-button-{{ section.id }}:hover {
    opacity: .95;
    background-color: #000000;
    color: #F32929;
  }

  .poster-button-{{ section.id }} .animation {
    border-radius: 100%;
    animation: ripple-{{ section.id }} 0.6s linear infinite;
  }

  @keyframes ripple-{{ section.id }} {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.1), 0 0 0 20px rgba(255, 255, 255, 0.1), 0 0 0 40px rgba(255, 255, 255, 0.1), 0 0 0 60px rgba(255, 255, 255, 0.1);
    }
    100% {
      box-shadow: 0 0 0 20px rgba(255, 255, 255, 0.1), 0 0 0 40px rgba(255, 255, 255, 0.1), 0 0 0 60px rgba(255, 255, 255, 0.1), 0 0 0 80px rgba(255, 255, 255, 0);
    }
  }

  @media screen and (max-width: 768px) {
    .poster-button-{{ section.id }} {
      right: 50%;
      transform: translateX(50%);
      font-size: 14px;
      padding: 8px 16px;
      min-width: 160px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="vusion-poster-container-{{ section.id }}">
      {% if section.settings.poster_image != blank %}
        <div class="vusion-poster-{{ section.id }}">
          <img
            src="{{ section.settings.poster_image | img_url: 'master' }}"
            alt="{{ section.settings.poster_image.alt | escape }}"
            loading="lazy"
          >
          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link }}" class="poster-button-{{ section.id }}">
              <i class="animation"></i>
              {{ section.settings.button_text }}
              <i class="animation"></i>
            </a>
          {% endif %}
        </div>
      {% else %}
        <div class="vusion-poster-{{ section.id }}">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
