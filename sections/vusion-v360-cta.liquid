{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.button_1_link != blank
    assign button_1_link = section.settings.button_1_link
  else
    assign button_1_link = '#experience'
  endif
  if section.settings.button_2_link != blank
    assign button_2_link = section.settings.button_2_link
  else
    assign button_2_link = '#models'
  endif
-%}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div class="vusion-v360 vusion-v360-final vusion-v360-band">
  <div class="vusion-v360-wrap vusion-v360-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <div class="vusion-v360-eyebrow vusion-v360-final__eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="vusion-v360-disp">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.lede != blank -%}
      <p>{{ section.settings.lede | escape }}</p>
    {%- endif -%}
    <div class="vusion-v360-btn-row">
      {%- if section.settings.button_1_label != blank -%}
        <a class="vusion-v360-btn vusion-v360-btn--primary" href="{{ button_1_link }}">
          {{ section.settings.button_1_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="vusion-v360-btn vusion-v360-btn--outline" href="{{ button_2_link }}">
          {{ section.settings.button_2_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vusion-v360.vusion-v360-final {
    text-align: center;
    background:
      radial-gradient(ellipse 800px 400px at 50% 0%, rgba(225, 35, 26, 0.14), transparent 65%),
      var(--vh-bg);
    border-top: 1px solid var(--vh-hairline);
  }

  .vusion-v360-final__eyebrow {
    justify-content: center;
  }

  .vusion-v360-final h2 {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
    margin: 0 0 22px;
  }

  .vusion-v360-final p {
    color: var(--vh-ink-dim);
    font-size: var(--vh-fs-lede);
    margin: 0 0 40px;
  }

  .vusion-v360-final .vusion-v360-btn-row {
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 CTA",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ready when you are"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to experience V360?"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Test it on your own ears, in your own booth, before you decide."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Book Demo"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link",
      "info": "Empty uses #experience"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link",
      "info": "Empty uses #models"
    }
  ],
  "presets": [
    {
      "name": "Vusion V360 CTA"
    }
  ]
}
{% endschema %}
