{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div
  class="vusion-v360 vusion-v360-specs vusion-v360-band"
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
>
  <div class="vusion-v360-wrap">
    <div class="vusion-v360-head vusion-v360-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-v360-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-v360-disp">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vusion-v360-specs__grid vusion-v360-reveal">
        {%- for block in section.blocks -%}
          <div class="vusion-v360-specs__item" {{ block.shopify_attributes }}>
            {%- if block.settings.key != blank -%}
              <div class="vusion-v360-specs__key">{{ block.settings.key | escape }}</div>
            {%- endif -%}
            {%- if block.settings.value != blank -%}
              <div class="vusion-v360-specs__value">{{ block.settings.value | escape }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vusion-v360-specs .vusion-v360-head h2 {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
  }

  .vusion-v360-specs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 50px;
    border-top: 1px solid var(--vh-hairline);
  }

  .vusion-v360-specs__item {
    padding: 22px 20px 22px 0;
    border-bottom: 1px solid var(--vh-hairline);
  }

  .vusion-v360-specs__key {
    font-family: var(--font-body-family);
    font-size: var(--vh-fs-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--vh-ink-faint);
    margin-bottom: 8px;
  }

  .vusion-v360-specs__value {
    font-size: var(--vh-fs-body);
    color: var(--vh-ink);
  }

  @media (max-width: 760px) {
    .vusion-v360-specs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .shopify-section:has(.vusion-v360-specs) + .shopify-section:has(.vusion-v360-specs) .vusion-v360.vusion-v360-specs {
    padding-top: 40px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Specs",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vusion V360"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "specs"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Label",
          "default": "Drivers"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Three balanced armature receivers"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vusion V360 Specs",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "key": "Drivers",
            "value": "Three balanced armature receivers"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Configuration",
            "value": "1 High, 2 Mid/Low"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Frequency response",
            "value": "30 Hz – 20 kHz"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Impedance",
            "value": "16 Ohm @ 1 kHz"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Crossover",
            "value": "2-Way"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Isolation",
            "value": "−26 dB (±2 dB)"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Socket",
            "value": "T2™ or 2-Pin"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Termination",
            "value": "1/8\" (3.5 mm) stereo jack"
          }
        }
      ]
    }
  ]
}
{% endschema %}
