{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.button_link != blank
    assign button_link = section.settings.button_link
  else
    assign button_link = '#experience'
  endif
-%}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div class="vusion-v360 vusion-v360-supper vusion-v360-band" id="supper">
  <div class="vusion-v360-wrap vusion-v360-supper__grid">
    <div class="vusion-v360-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-v360-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-v360-disp vusion-v360-supper__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="vusion-v360-supper__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="vusion-v360-btn vusion-v360-btn--outline" href="{{ button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vusion-v360-supper__photos vusion-v360-reveal">
        {%- for block in section.blocks -%}
          {%- liquid
            case forloop.index
              when 1
                assign fallback = 'vusion-v360-supper-01.webp'
              when 2
                assign fallback = 'vusion-v360-supper-02.webp'
              when 3
                assign fallback = 'vusion-v360-supper-03.webp'
              else
                assign fallback = ''
            endcase
            assign photo_alt = block.settings.image_alt | default: block.settings.caption
            if block.settings.image != blank and block.settings.image.alt != blank
              assign photo_alt = block.settings.image.alt
            endif
          -%}
          <div
            class="vusion-v360-supper__ph"
            {% if block.settings.caption != blank %}
              data-cap="{{ block.settings.caption | escape }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000, 1400',
                  sizes: '(min-width: 900px) 25vw, 50vw',
                  alt: photo_alt
              }}
            {%- elsif fallback != blank -%}
              <img
                src="{{ fallback | asset_url }}"
                alt="{{ photo_alt | escape }}"
                width="700"
                height="700"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vusion-v360-supper {
    position: relative;
  }

  .vusion-v360-supper__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .vusion-v360-supper__heading {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
    line-height: 1.06;
    margin: 0;
  }

  .vusion-v360-supper__lede {
    color: var(--vh-ink-dim);
    font-size: var(--vh-fs-body);
    line-height: 1.7;
    margin: 20px 0 30px;
  }

  .vusion-v360-supper__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .vusion-v360-supper__ph {
    border-radius: 3px;
    border: 1px solid var(--vh-hairline);
    background: linear-gradient(150deg, #171717, #08080 70%, #050505);
    position: relative;
    overflow: hidden;
  }

  .vusion-v360-supper__ph:nth-child(1) {
    aspect-ratio: 3 / 4;
    grid-row: span 2;
  }

  .vusion-v360-supper__ph:nth-child(2),
  .vusion-v360-supper__ph:nth-child(3) {
    aspect-ratio: 4 / 3;
  }

  .vusion-v360-supper__ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vusion-v360-supper__ph::before {
    content: attr(data-cap);
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-family: var(--font-body-family);
    font-size: var(--vh-fs-caption);
    color: #f4f1ea;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    z-index: 2;
  }

  .vusion-v360-supper__ph::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0) 45%);
    z-index: 1;
  }

  @media (max-width: 900px) {
    .vusion-v360-supper__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Supperclub",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Exclusive access"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Supperclub Soundcheck"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Together with Vusion, get exclusive access to a professional soundcheck at the iconic Supperclub Amsterdam. Experience V360 the way it's meant to be heard — behind a DJ booth or on a live stage, on a professional sound system, without an audience. No showroom. A real practice run."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Reserve Your Soundcheck"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty links to #experience."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Content > Files. Empty uses the theme WebP fallback for this slot."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt",
          "default": "Supperclub Amsterdam venue"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Supperclub Amsterdam"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Vusion V360 Supperclub",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "image_alt": "Supperclub Amsterdam venue",
            "caption": "Supperclub Amsterdam"
          }
        },
        {
          "type": "photo",
          "settings": {
            "image_alt": "DJ booth at Supperclub",
            "caption": "DJ Booth"
          }
        },
        {
          "type": "photo",
          "settings": {
            "image_alt": "Crowd and lightshow at Supperclub",
            "caption": "Lightshow"
          }
        }
      ]
    }
  ]
}
{% endschema %}
