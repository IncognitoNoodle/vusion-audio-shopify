{{ 'vusion-helias.css' | asset_url | stylesheet_tag }}

<script src="{{ 'vusion-helias.js' | asset_url }}" defer="defer"></script>

<div class="vusion-helias vusion-helias-faq vusion-helias-band" id="faq">
  <div class="vusion-helias-wrap">
    <div class="vusion-helias-head vusion-helias-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-helias-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-helias-disp">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vusion-helias-faq__list vusion-helias-reveal">
        {%- for block in section.blocks -%}
          <div class="vusion-helias-faq__item" {{ block.shopify_attributes }}>
            <div class="vusion-helias-faq__q">
              {{- block.settings.question | escape -}}
              <span class="vusion-helias-faq__plus" aria-hidden="true">+</span>
            </div>
            <div class="vusion-helias-faq__a">
              {%- if block.settings.answer != blank -%}
                <p>{{ block.settings.answer | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vusion-helias.vusion-helias-faq {
    background: var(--vh-bg-panel);
    border-top: 1px solid var(--vh-hairline);
    border-bottom: 1px solid var(--vh-hairline);
  }

  .vusion-helias-faq .vusion-helias-wrap {
    max-width: 820px;
  }

  .vusion-helias-faq .vusion-helias-head h2 {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
  }

  .vusion-helias-faq__item {
    border-bottom: 1px solid var(--vh-hairline);
  }

  .vusion-helias-faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 0;
    cursor: pointer;
    font-size: var(--vh-fs-body);
    font-weight: 500;
  }

  .vusion-helias-faq__plus {
    font-family: var(--font-body-family);
    color: var(--vh-gold);
    font-size: var(--vh-fs-lede);
    transition: transform 0.25s ease;
  }

  .vusion-helias-faq__item.is-open .vusion-helias-faq__plus {
    transform: rotate(45deg);
  }

  .vusion-helias-faq__a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .vusion-helias-faq__a p {
    padding-bottom: 24px;
    color: var(--vh-ink-dim);
    font-size: var(--vh-fs-body);
    line-height: 1.6;
    max-width: 640px;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion Helias FAQ",
  "tag": "section",
  "class": "vusion-helias-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I turn the ambient level up?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes — ambient level is controlled wirelessly, from fully sealed to fully open, adjustable on the fly during your set."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vusion Helias FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Can I turn the ambient level up?",
            "answer": "Yes — ambient level is controlled wirelessly, from fully sealed to fully open, adjustable on the fly during your set."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "[Battery life detail to confirm with product team.]"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What happens when the battery runs out?",
            "answer": "Helias falls back to passive wired monitoring, so you're never left without sound mid-performance."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can I choose custom artwork?",
            "answer": "Yes — every Helias is custom-shelled, with a range of colours and finishes to choose from at checkout."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can I use my own ear impressions?",
            "answer": "Yes — send us existing impressions from an audiologist, or book a Helias Experience and we'll take them for you."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you ship worldwide?",
            "answer": "Yes, Vusion ships Helias internationally. Shipping costs and timelines are shown at checkout."
          }
        }
      ]
    }
  ]
}
{% endschema %}
