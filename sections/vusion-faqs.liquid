{%- style -%}
  .vusion-faqs__container {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 3rem;
    padding-right: 3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .vusion-faqs__title-wrapper {
    margin-bottom: 3rem;
    text-align: left;
  }

  .vusion-faqs__title {
    margin: 4rem 0 0;
    color: rgb(var(--color-foreground));
  }

  .vusion-faqs__item {
    display: block;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .vusion-faqs__details {
    display: block;
  }

  .vusion-faqs__summary {
    display: flex;
    position: relative;
    line-height: 1;
    padding: 2rem 0;
    cursor: pointer;
    list-style: none;
    color: rgb(var(--color-foreground));
  }

  .vusion-faqs__icon {
    width: 24px;
    height: 24px;
    margin-right: 1.5rem;
    flex: 0 0 auto;
    position: relative;
    color: rgb(var(--color-foreground));
  }

  .vusion-faqs__icon svg {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  .vusion-faqs__icon .icon-minus {
    display: none;
  }

  .vusion-faqs__details[open] .vusion-faqs__icon .icon-minus {
    display: block;
  }

  .vusion-faqs__details[open] .vusion-faqs__icon .icon-plus {
    display: none;
  }

  .vusion-faqs__content {
    margin-bottom: 2rem;
    padding-right: 5rem;
    padding-left: calc(24px + 1.5rem); /* Match icon width + margin */
    color: rgba(var(--color-foreground), 0.75);
  }

  .vusion-faqs__content p {
    margin: 0 0 1rem;
  }

  .vusion-faqs__content ol,
  .vusion-faqs__content ul {
    margin: 0 0 1rem 2rem;
    padding: 0;
  }

  .vusion-faqs__content a {
    color: rgb(var(--color-link));
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  @media screen and (max-width: 749px) {
    .vusion-faqs__container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .vusion-faqs__content {
      padding-right: 0;
      padding-left: calc(24px + 1.5rem);
    }
  }
{%- endstyle -%}

<div class="vusion-faqs__container color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="vusion-faqs__title-wrapper">
      <h2 class="vusion-faqs__title h2">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div class="vusion-faqs__item" {{ block.shopify_attributes }}>
      <details class="vusion-faqs__details">
        <summary class="vusion-faqs__summary">
          <span class="vusion-faqs__icon">
            <svg class="icon-plus" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <svg class="icon-minus" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <span>{{ block.settings.question }}</span>
        </summary>
        <div class="vusion-faqs__content rte">
          {{ block.settings.answer }}
        </div>
      </details>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Vusion FAQs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Q: What is Vusion Audio and what products do you provide?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Vusion Audio, powered by Inearz, specializes in premium in-ear monitoring solutions for DJs and musicians. We offer custom in-ear monitors (IEMs), professional earplugs, and other audio enhancement products backed by 50 years of innovation from our parent company Persona Medical.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vusion FAQs",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Q: What is Vusion Audio and what products do you provide?",
            "answer": "<p>Vusion Audio, powered by Inearz, specializes in premium in-ear monitoring solutions for DJs and musicians. We offer custom in-ear monitors (IEMs), professional earplugs, and other audio enhancement products backed by 50 years of innovation from our parent company Persona Medical.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Q: How do I purchase your products?",
            "answer": "<p>You can purchase directly through our website www.vusionaudio.com. Simply add products to your cart and complete checkout using our secure payment system.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
