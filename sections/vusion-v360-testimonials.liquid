{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div class="vusion-v360 vusion-v360-testimonials vusion-v360-band">
  <div class="vusion-v360-wrap">
    <div class="vusion-v360-head vusion-v360-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-v360-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-v360-disp">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vusion-v360-testimonials__grid vusion-v360-reveal">
        {%- for block in section.blocks -%}
          {%- liquid
            assign featured = false
            if forloop.first and section.blocks.size > 2
              assign featured = true
            endif
            assign fallback = ''
            if section.blocks.size > 2
              case forloop.index
                when 1
                  assign fallback = 'vusion-v360-testi-tiago.jpg'
                when 2
                  assign fallback = 'vusion-v360-testi-01.webp'
                when 3
                  assign fallback = 'vusion-v360-testi-02.webp'
              endcase
            else
              case forloop.index
                when 1
                  assign fallback = 'vusion-v360-testi-01.webp'
                when 2
                  assign fallback = 'vusion-v360-testi-02.webp'
              endcase
            endif
            assign avatar_alt = block.settings.image_alt | default: block.settings.name
            if block.settings.image != blank and block.settings.image.alt != blank
              assign avatar_alt = block.settings.image.alt
            endif
          -%}
          <div class="vusion-v360-testimonials__card{% if featured %} vusion-v360-testimonials__card--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.quote != blank -%}
              <p>{{ block.settings.quote | escape }}</p>
            {%- endif -%}
            <div class="vusion-v360-testimonials__who">
              <div class="vusion-v360-testimonials__avatar">
                {%- if block.settings.image != blank -%}
                  {%- if featured -%}
                    {{
                      block.settings.image
                      | image_url: width: 960
                      | image_tag:
                        loading: 'lazy',
                        widths: '480, 720, 960',
                        sizes: '(min-width: 761px) 240px, 100vw',
                        alt: avatar_alt
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 208
                      | image_tag:
                        loading: 'lazy',
                        widths: '52, 104, 208',
                        sizes: '52px',
                        alt: avatar_alt
                    }}
                  {%- endif -%}
                {%- elsif fallback != blank -%}
                  <img
                    src="{{ fallback | asset_url }}"
                    alt="{{ avatar_alt | escape }}"
                    {% if featured %}
                      width="480"
                      height="600"
                    {% else %}
                      width="52"
                      height="52"
                    {% endif %}
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <div>
                {%- if block.settings.name != blank -%}
                  <div class="vusion-v360-testimonials__name">{{ block.settings.name | escape }}</div>
                {%- endif -%}
                {%- if block.settings.role != blank -%}
                  <div class="vusion-v360-testimonials__role">{{ block.settings.role | escape }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vusion-v360.vusion-v360-testimonials {
    background: var(--vh-bg-panel);
  }

  .vusion-v360-testimonials .vusion-v360-head h2 {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
  }

  .vusion-v360-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--vh-hairline);
    border: 1px solid var(--vh-hairline);
    margin-top: 60px;
  }

  .vusion-v360-testimonials__card {
    background: var(--vh-bg);
    padding: 36px;
  }

  .vusion-v360-testimonials__card p {
    font-size: var(--vh-fs-body);
    line-height: 1.6;
    color: var(--vh-ink);
    margin: 0 0 22px;
  }

  .vusion-v360-testimonials__card--featured {
    grid-column: 1 / -1;
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .vusion-v360-testimonials__card--featured p {
    flex: 1;
    order: 2;
    margin: 0;
    font-size: var(--vh-fs-body);
    line-height: 1.55;
  }

  .vusion-v360-testimonials__card--featured .vusion-v360-testimonials__who {
    order: 1;
    flex-direction: column;
    align-items: flex-start;
    max-width: 240px;
    flex: none;
  }

  .vusion-v360-testimonials__card--featured .vusion-v360-testimonials__avatar {
    width: 240px;
    height: 300px;
    border-radius: 3px;
  }

  .vusion-v360-testimonials__card--featured .vusion-v360-testimonials__avatar img {
    object-position: 30% 20%;
  }

  .vusion-v360-testimonials__who {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .vusion-v360-testimonials__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(160deg, #e2231a, #5c0f0c);
    flex: none;
    overflow: hidden;
  }

  .vusion-v360-testimonials__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vusion-v360-testimonials__name {
    font-size: var(--vh-fs-body);
    font-weight: 600;
  }

  .vusion-v360-testimonials__role {
    font-size: var(--vh-fs-small);
    color: var(--vh-ink-faint);
  }

  @media (max-width: 760px) {
    .vusion-v360-testimonials__grid {
      grid-template-columns: 1fr;
    }

    .vusion-v360-testimonials__card--featured {
      flex-direction: column;
    }

    .vusion-v360-testimonials__card--featured .vusion-v360-testimonials__who {
      max-width: none;
    }

    .vusion-v360-testimonials__card--featured .vusion-v360-testimonials__avatar {
      width: 100%;
      height: 240px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Quotes",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Artists on V360"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't take our word for it"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"For comfortable in-ears to play with, I would choose Vusion Audio for sure! Their perfect fit and superior sound quality make them my top pick for any performance.\""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Avatar",
          "info": "Content > Files. Empty uses the theme WebP fallback for this card slot."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Avatar alt",
          "default": "Wade"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Wade"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "DJ & Producer"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Vusion V360 Quotes",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "\"There is a learning curve and getting used to the sound of the mics in the in-ears, but for the first time in my career I can use in-ears for two hours straight without feeling isolated, and with a great clear sound.\"",
