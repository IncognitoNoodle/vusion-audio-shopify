{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div class="vusion-v360 vusion-v360-works vusion-v360-band">
  <div class="vusion-v360-wrap">
    <div class="vusion-v360-head vusion-v360-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-v360-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-v360-disp vusion-v360-works__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p>{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vusion-v360-works__signal vusion-v360-reveal">
        {%- for block in section.blocks -%}
          {%- unless forloop.first -%}
            <div class="vusion-v360-works__arrow" aria-hidden="true">→</div>
          {%- endunless -%}
          <div class="vusion-v360-works__node" {{ block.shopify_attributes }}>
            <div class="vusion-v360-works__icon">
              {%- case block.settings.icon -%}
                {%- when 'bars' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="#E2231A" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="9" width="4" height="6"></rect>
                    <rect x="10" y="5" width="4" height="14"></rect>
                    <rect x="17" y="8" width="4" height="8"></rect>
                  </svg>
                {%- when 'rings' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="#E2231A" stroke-width="1.6" aria-hidden="true">
                    <circle cx="12" cy="12" r="3"></circle>
                    <circle cx="12" cy="12" r="8" stroke-dasharray="2 3"></circle>
                  </svg>
                {%- when 'wave' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="#E2231A" stroke-width="1.6" aria-hidden="true">
                    <path d="M4 12h4l3-7 4 14 3-7h2"></path>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="#E2231A" stroke-width="1.6" aria-hidden="true">
                    <path d="M12 1a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V5a4 4 0 0 0-4-4z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"></path>
                  </svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.label != blank -%}
              <div class="vusion-v360-works__lbl">{{ block.settings.label | escape }}</div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="vusion-v360-works__desc">{{ block.settings.text | escape }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="vusion-v360-works__note vusion-v360-reveal">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .vusion-v360.vusion-v360-works {
    background: var(--vh-bg-panel);
  }

  .vusion-v360-works .vusion-v360-head h2 {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
  }

  .vusion-v360-works__signal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 70px;
    flex-wrap: wrap;
  }

  .vusion-v360-works__node {
    flex: 1;
    min-width: 150px;
    text-align: center;
  }

  .vusion-v360-works__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    border-radius: 50%;
    border: 1px solid var(--vh-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--vh-bg-panel-2);
  }

  .vusion-v360-works__icon svg {
    width: 26px;
    height: 26px;
  }

  .vusion-v360-works__lbl {
    font-family: var(--font-body-family);
    font-size: var(--vh-fs-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vh-gold);
    margin-bottom: 6px;
  }

  .vusion-v360-works__desc {
    font-size: var(--vh-fs-small);
    color: var(--vh-ink-dim);
  }

  .vusion-v360-works__arrow {
    flex: none;
    color: var(--vh-ink-faint);
    font-size: var(--vh-fs-lede);
    padding-bottom: 40px;
  }

  .vusion-v360-works__note {
    margin: 50px auto 0;
    text-align: center;
    font-size: var(--vh-fs-lede);
    color: var(--vh-ink);
    max-width: 560px;
  }

  .vusion-v360-works__note b,
  .vusion-v360-works__note strong {
    color: var(--vh-gold);
  }

  @media (max-width: 760px) {
    .vusion-v360-works__arrow {
      transform: rotate(90deg);
      padding-bottom: 0;
    }

    .vusion-v360-works__signal {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Works",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The technology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Active Ambient works"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "A standard IEM seals you off completely. V360 listens back — and lets you decide how much of the world you let in."
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "Closing note",
      "default": "You decide how much of the room you let in — <b>from fully sealed to fully open</b>, in one wireless control."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mic", "label": "Microphone" },
            { "value": "bars", "label": "Bars" },
            { "value": "rings", "label": "Rings" },
            { "value": "wave", "label": "Wave" }
          ],
          "default": "mic"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Microphones"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Dual external mics capture the room in real time"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Vusion V360 Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "mic",
            "label": "Microphones",
            "text": "Dual external mics capture the room in real time"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "bars",
            "label": "DSP",
            "text": "Onboard processing balances ambient and monitor mix"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "rings",
            "label": "Realtime Ambient",
            "text": "Blended instantly into your in-ear mix, zero lag"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "wave",
            "label": "You",
            "text": "One dial decides how much of the room you hear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
