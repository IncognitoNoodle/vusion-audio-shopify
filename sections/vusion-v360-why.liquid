{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign why_alt = section.settings.caption | default: section.settings.heading
  if section.settings.image != blank and section.settings.image.alt != blank
    assign why_alt = section.settings.image.alt
  endif
-%}

<script src="{{ 'vusion-v360.js' | asset_url }}" defer="defer"></script>

<div class="vusion-v360 vusion-v360-why vusion-v360-band" id="why">
  <div class="vusion-v360-wrap vusion-v360-why__grid">
    <div class="vusion-v360-reveal">
      <div class="vusion-v360-why__visual">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 800, 1200, 1400',
              sizes: '(min-width: 900px) 42vw, 100vw',
              class: 'vusion-v360-why__img',
              alt: why_alt
          }}
        {%- else -%}
          <img
            class="vusion-v360-why__img"
            src="{{ 'vusion-v360-why.webp' | asset_url }}"
            alt="{{ why_alt | escape }}"
            width="800"
            height="800"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}
        <p class="vusion-v360-note vusion-v360-why__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
    <div class="vusion-v360-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="vusion-v360-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vusion-v360-disp vusion-v360-why__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h2>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="vusion-v360-why__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="vusion-v360-why__mk">{{ block.settings.number | escape }}</span>
              <span>
                {%- if block.settings.title != blank -%}
                  <b>{{ block.settings.title | escape }}</b>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  {{ ' ' }}{{ block.settings.text | escape }}
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vusion-v360.vusion-v360-why {
    background: var(--vh-bg-panel);
    border-top: 1px solid var(--vh-hairline);
    border-bottom: 1px solid var(--vh-hairline);
  }

  .vusion-v360-why__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
    align-items: center;
  }

  .vusion-v360-why__visual {
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    background: linear-gradient(160deg, #181818, #0a0a0a);
    border: 1px solid var(--vh-hairline);
    position: relative;
    overflow: hidden;
  }

  .vusion-v360-why__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vusion-v360-why__caption {
    margin-top: 10px;
  }

  .vusion-v360-why__heading {
    font-size: clamp(var(--vh-fs-h3), 3.2vw, var(--vh-fs-h2));
    line-height: 1.08;
    margin: 0;
    color: var(--vh-ink);
  }

  .vusion-v360-why__list {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
  }

  .vusion-v360-why__list li {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--vh-hairline);
    font-size: var(--vh-fs-body);
    color: var(--vh-ink-dim);
  }

  .vusion-v360-why__list b {
    color: var(--vh-ink);
    font-weight: 600;
  }

  .vusion-v360-why__mk {
    color: var(--vh-gold);
    font-family: var(--font-body-family);
    font-size: var(--vh-fs-small);
    flex: none;
    padding-top: 2px;
  }

  @media (max-width: 900px) {
    .vusion-v360-why__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Why",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Content > Files. Empty uses the theme WebP fallback."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "V360 — dual-driver custom shell"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why V360"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Traditional IEMs isolate you.\nV360 doesn't."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The crowd."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feel the energy you're performing for."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vusion V360 Why",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "number": "01",
            "title": "The crowd.",
            "text": "Feel the energy you're performing for."
          }
        },
        {
          "type": "item",
          "settings": {
            "number": "02",
            "title": "Your band.",
            "text": "Real communication, no guessing."
          }
        },
        {
          "type": "item",
          "settings": {
            "number": "03",
            "title": "Stage comms.",
            "text": "Hear technicians, bandmates and the MC."
          }
        },
        {
          "type": "item",
          "settings": {
            "number": "04",
            "title": "Your surroundings.",
            "text": "All while keeping studio-quality monitoring."
          }
        }
      ]
    }
  ]
}
{% endschema %}
