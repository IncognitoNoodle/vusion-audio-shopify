{{ 'vusion-v360.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign calendly_url = 'https://calendly.com/vusionaudio/vusion-audio-consult-clone'
  if section.settings.button_1_link != blank
    assign button_1_link = section.settings.button_1_link
  else
    assign button_1_link = calendly_url
  endif
  if section.settings.button_2_link != blank
    assign button_2_link = section.settings.button_2_link
  else
    assign button_2_link = '#models'
  endif
-%}

<div class="vusion-v360 vusion-v360-hero">
  <div class="vusion-v360-wrap vusion-v360-hero__inner">
    <div>
      {%- if section.settings.lead_tag != blank -%}
        <div class="vusion-v360-hero__lead">{{ section.settings.lead_tag | escape }}</div>
      {%- endif -%}
      <h1 class="vusion-v360-disp vusion-v360-hero__heading">
        {{ section.settings.heading | escape | newline_to_br }}
        {%- if section.settings.heading_accent != blank -%}
          <br>
          <span class="vusion-v360-hero__heading-accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.lede != blank -%}
        <p class="vusion-v360-hero__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      <div class="vusion-v360-btn-row">
        {%- if section.settings.button_1_label != blank -%}
          <a
            class="vusion-v360-btn vusion-v360-btn--primary"
            href="{{ button_1_link }}"
            {% if button_1_link contains 'calendly.com' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ section.settings.button_1_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="vusion-v360-btn vusion-v360-btn--outline" href="{{ button_2_link }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="vusion-v360-hero__visual">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'vusion-v360-hero__photo'
        }}
      {%- else -%}
        <video
          class="vusion-v360-hero__photo"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="{{ section.settings.caption | escape }}"
        >
          <source src="{{ 'vusion-v360-hero.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}
      <div class="vusion-v360-hero__cap">
        {%- if section.settings.caption != blank -%}
          <span class="vusion-v360-note">{{ section.settings.caption | escape }}</span>
        {%- endif -%}
        <div class="vusion-v360-wave" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .vusion-v360-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 160px 0 100px;
    background:
      radial-gradient(ellipse 900px 500px at 80% 15%, rgba(225, 35, 26, 0.1), transparent 60%),
      radial-gradient(ellipse 700px 500px at 10% 90%, rgba(225, 35, 26, 0.06), transparent 60%),
      var(--vh-bg);
    overflow: hidden;
  }

  .vusion-v360-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(244, 241, 234, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 234, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 800px 500px at 70% 30%, black, transparent);
  }

  .vusion-v360-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 60px;
    align-items: center;
    width: 100%;
  }

  .vusion-v360-hero__heading {
    /* Monument Extended is ~1.53× wider than the HTML's Big Shoulders Display at the same px. */
    font-size: clamp(var(--vh-fs-h3), 4.55vw, var(--vh-fs-hero));
    line-height: 0.96;
    margin: 0 0 26px;
    color: var(--vh-ink);
    max-width: 100%;
  }

  .vusion-v360-hero__heading-accent {
    color: var(--vh-gold);
  }

  .vusion-v360-hero__lede {
    font-size: var(--vh-fs-lede);
    color: var(--vh-ink-dim);
    max-width: 460px;
    margin: 0 0 38px;
    line-height: 1.6;
  }

  .vusion-v360-hero__lead {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    font-family: var(--font-body-family);
    font-size: var(--vh-fs-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vh-gold);
    background: var(--vh-gold-soft);
    border: 1px solid rgba(225, 35, 26, 0.35);
    padding: 7px 14px;
    border-radius: 20px;
  }

  .vusion-v360-hero__lead::before {
    content: "●";
    font-size: 8px;
  }

  .vusion-v360-hero__visual {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(155deg, #1a1a1a 0%, #0e0e0e 55%, #050505 100%);
    border: 1px solid var(--vh-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vusion-v360-hero__visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.05) 55%);
    z-index: 1;
    pointer-events: none;
  }

  .vusion-v360-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vusion-v360-hero__cap {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
    gap: 12px;
  }

  .vusion-v360-wave span:nth-child(1) { height: 14px; animation-delay: 0s; }
  .vusion-v360-wave span:nth-child(2) { height: 26px; animation-delay: 0.15s; }
  .vusion-v360-wave span:nth-child(3) { height: 18px; animation-delay: 0.3s; }
  .vusion-v360-wave span:nth-child(4) { height: 30px; animation-delay: 0.45s; }
  .vusion-v360-wave span:nth-child(5) { height: 12px; animation-delay: 0.6s; }

  @media (max-width: 960px) {
    .vusion-v360-hero__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vusion V360 Hero",
  "tag": "section",
  "class": "vusion-v360-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "lead_tag",
      "label": "Lead tag",
      "default": "For DJs who won't compromise"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "HEAR\nEVERYTHING."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent line",
      "default": "LOSE NOTHING."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "V360 is a professional in-ear monitor with Active Ambient Technology — studio-quality monitoring, without losing the room. Designed for performers who refuse to compromise."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Book Your Experience"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link",
      "info": "Blank uses the Calendly booking URL."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link",
      "info": "Blank uses #models"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Content > Files. Empty uses the theme MP4 fallback."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Video caption",
      "default": "V360 — Active Ambient in-ear monitor"
    }
  ],
  "presets": [
    {
      "name": "Vusion V360 Hero"
    }
  ]
}
{% endschema %}
